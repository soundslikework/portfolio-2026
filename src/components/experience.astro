---
import TimelineItem from "./TimelineItem.astro";
---

<section
  id="experience"
  class="min-h-screen flex items-center justify-center bg-linear-to-b from-myColor-700 to-myColor-600 py-20"
>
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="section-heading text-center mb-16">Selected Experience</h2>

    <ul class="timeline">
      <TimelineItem
        title="Engineering Manager"
        company="Relay Financial"
        year="2026 - present"
        summary="Led a team of engineers developing features for Relay's Revenue team. Conducted performance reviews, iterated on team rituals, mentored engineers."
      />
      <TimelineItem
        title="Engineering Manager"
        company="Ada Support"
        year="2025 - 2026"
        summary="Led 1-2 teams (5-8 engineers at a time) developing features for Ada's AI-powered customer support platform. Planned, managed and delivered key projects like Simulations, MCP server & API improvements, improving security and performance of Ada's systems. Conducted performance reviews, team rituals, mentored engineers. Built a case for and promoted 1 engineer."
      />
      <TimelineItem
        title="Senior Engineer"
        company="Ada Support"
        year="2024 - 2025"
        summary="Planned and delivered projects for Ada's Growth team, focused on Free Trial experience, content ingestion and onboarding experience."
      />
      <TimelineItem
        title="Senior Engineer"
        company="Wattpad"
        year="2022 - 2024"
        summary=`Led web execution of various projects, including Wattpad's design system and <a class="link" href="/wattpad-publishing-scheduler.pdf">Publishing Scheduler</a>. Worked closely with product managers, designers, and backend engineers
      to deliver new features and improve user experience on Wattpad's platform.
      Mentored junior engineers and conducted code reviews to ensure
      high-quality code standards`
      />
      <TimelineItem
        title="Engineer"
        company="Wattpad"
        year="2018 - 2022"
        summary="Worked on Ads Squad, Creators Squad and Wattpad's Marketing Team to plan and develop web features, including header bidding, various ad improvements, and rewriting Backbone apps in React."
      />
    </ul>
  </div>
</section>

<script>
  const items = document.querySelectorAll(".timeline-item");
  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!prefersReduced) {
    items.forEach((item) => item.classList.add("is-hidden"));
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove("is-hidden");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 },
  );

  items.forEach((item) => observer.observe(item));
</script>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
  }

  /* Accent gradient vertical line */
  .timeline::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--color-accent),
      rgb(var(--color-accent-rgb) / 0.1)
    );
  }
</style>
