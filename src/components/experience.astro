---
import TimelineItem from "./TimelineItem.astro";
---

<section
  id="experience"
  class="min-h-screen flex items-center justify-center bg-linear-to-b from-myColor-700 to-myColor-600 py-20"
>
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="experience-heading text-center mb-16">
      Selected Experience
    </h2>

    <ul class="timeline">
      <TimelineItem
        title="Team Lead - Adoption Team"
        company="Ada Support"
        year="2025 - present"
        summary="Led team of engineers developing features for Ada's AI-powered customer support platform. Planned, managed and delivered key projects improving security and performance of Ada's systems. Conducted performance reviews, team rituals, mentored engineers."
      />
      <TimelineItem
        title="Senior Engineer - Growth Team"
        company="Ada Support"
        year="2024 - 2025"
        summary="Planned and delivered projects for Ada's Growth team, focused on Free Trial experience, content ingestion and onboarding experience."
      />
      <TimelineItem
        title="Senior Engineer - Web Team"
        company="Wattpad"
        year="2022 - 2024"
        summary="Led web execution of various projects, including Wattpad's design system and a publishing scheduler. Worked closely with product managers, designers, and backend engineers to deliver new features and improve user experience on Wattpad's platform. Mentored junior engineers and conducted code reviews to ensure high-quality code standards"
      />
      <TimelineItem
        title="Engineer - Ads Squad, Creators Squad, Marketing Team"
        company="Wattpad"
        year="2018 - 2022"
        summary="Worked on various Wattpad teams to plan and develop web features, including header bidding, various ad improvements, and rewriting Backbone apps in React."
      />
    </ul>
  </div>
</section>

<script>
  const items = document.querySelectorAll(".timeline-item");
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReduced) {
    items.forEach((item) => item.classList.add("is-hidden"));
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove("is-hidden");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 },
  );

  items.forEach((item) => observer.observe(item));
</script>

<style>
  .experience-heading {
    font-family: var(--font-family-display);
    font-size: clamp(48px, 8vw, 96px);
    color: var(--color-text-primary);
    line-height: 1.05;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
  }

  /* Accent gradient vertical line */
  .timeline::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--color-accent), rgb(var(--color-accent-rgb) / 0.1));
  }
</style>
