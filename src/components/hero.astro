---
import { Image } from "astro:assets";
import abProfile from "../assets/ab-profile.jpeg";
---

<section
  class="h-screen flex items-center justify-center bg-linear-to-b from-myColor-900 to-myColor-800 relative overflow-hidden"
>
  <!-- Subtle dot-grid background texture -->
  <div class="hero-dot-grid absolute inset-0 pointer-events-none"></div>

  <div class="text-center space-y-8 relative z-10">
    <div>
      <!-- Profile image with emerald accent ring -->
      <div class="hero-image-ring w-48 h-48 mx-auto mb-6 rounded-full p-[3px]">
        <Image
          src={abProfile}
          alt="Adam Brady"
          class="w-full h-full rounded-full object-cover"
        />
      </div>
      <h1 class="hero-name text-6xl md:text-7xl lg:text-8xl font-bold font-mono">
        Adam Brady
      </h1>
      <p class="text-xl md:text-2xl text-myColor-100 mt-4 font-sans">
        <span id="typed"></span>
      </p>
    </div>
    <div class="flex gap-6 justify-center">
      <a
        href="https://github.com/soundslikework"
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-3 bg-white text-myColor-900 font-semibold rounded-lg font-sans hover:bg-myColor-50 transition-all duration-200 shadow-lg hover:shadow-xl hover:-translate-y-0.5"
      >
        GitHub
      </a>
      <a
        href="https://linkedin.com/in/adampbrady"
        target="_blank"
        rel="noopener noreferrer"
        class="hero-linkedin-btn px-6 py-3 font-semibold rounded-lg font-sans shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200 text-white"
      >
        LinkedIn
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 scroll-bounce">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M7 10L12 15L17 10" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
</section>

<script>
  import Typed from "typed.js";

  new Typed("#typed", {
    strings: [
      "Senior Engineer",
      "Engineering Leader",
      "Code Wrangler",
      "General-purpose Nerd",
    ],
    typeSpeed: 40,
    backSpeed: 30,
    backDelay: 2000,
    loop: true,
    showCursor: true,
    cursorChar: "|",
  });
</script>

<style>
  .hero-dot-grid {
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .hero-image-ring {
    background: linear-gradient(135deg, #10b981, #34d399, #059669);
  }

  .hero-name {
    background: linear-gradient(to right, #ffffff, #34d399);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-linkedin-btn {
    background: linear-gradient(135deg, #10b981, #059669);
  }

  .hero-linkedin-btn:hover {
    background: linear-gradient(135deg, #34d399, #10b981);
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  .scroll-bounce {
    animation: bounce 2s ease-in-out infinite;
  }
</style>
