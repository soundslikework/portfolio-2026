---
import { Image } from "astro:assets";
import abProfile from "../assets/ab-profile.jpeg";
---

<section
  id="hero"
  class="h-screen flex items-center bg-myColor-900 relative overflow-hidden px-24 lg:px-32"
>
  <!-- Dot-grid background texture -->
  <div class="hero-dot-grid absolute inset-0 pointer-events-none"></div>

  <!-- Two-column layout -->
  <div
    class="relative z-10 w-full max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-[1fr_auto] gap-12 items-center"
  >
    <!-- Left: Name + tagline + CTAs -->
    <div>
      <h1 class="hero-name leading-none mb-4" aria-label="Adam Brady">
        <span class="hero-name-line block overflow-hidden">
          <span class="hero-name-inner block">ADAM</span>
        </span>
        <span class="hero-name-line block overflow-hidden">
          <span class="hero-name-inner block">BRADY</span>
        </span>
      </h1>
      <span class="name-rule" aria-hidden="true"></span>

      <p class="hero-tagline font-sans mt-6 mb-10">
        Engineering Manager. Senior Engineer. I lead teams that ship.
      </p>

      <div class="flex gap-8">
        <a
          href="https://github.com/soundslikework"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile (opens in a new tab)"
          class="hero-link font-mono text-sm"
        >
          GitHub <span aria-hidden="true">→</span>
        </a>
        <a
          href="https://linkedin.com/in/adampbrady"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile (opens in a new tab)"
          class="hero-link font-mono text-sm"
        >
          LinkedIn <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- Right: location badge + photo -->
    <div class="hidden md:flex flex-col items-center gap-4">
      <span class="location-badge font-mono text-xs">● Toronto</span>
      <div class="hero-image-ring w-32 h-32 rounded-full p-0.5">
        <Image
          src={abProfile}
          alt="Adam Brady"
          class="w-full h-full rounded-full object-cover hero-photo"
        />
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 scroll-bounce"
    aria-hidden="true"
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M7 10L12 15L17 10"
        stroke="#f87060"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </div>
</section>

<script>
  const inners = document.querySelectorAll(".hero-name-inner");
  inners.forEach((el, i) => {
    (el as HTMLElement).style.transitionDelay = `${100 + i * 150}ms`;
    (el as HTMLElement).classList.add("revealed");
  });

  const fadeEls = document.querySelectorAll(".hero-tagline, .hero-link");
  setTimeout(() => {
    fadeEls.forEach((el) => {
      (el as HTMLElement).classList.add("revealed");
    });
  }, 700);
</script>

<style>
  .hero-dot-grid {
    background-image: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.14) 1px,
      transparent 1px
    );
    background-size: 24px 24px;
  }

  /* Display font for the name */
  .hero-name {
    font-family: var(--font-family-display);
    font-size: clamp(72px, 12vw, 148px);
    color: #f0ede8;
    position: relative;
  }

  /* Mask reveal: each line slides up from hidden */
  .hero-name-inner {
    transform: translateY(110%);
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
    display: inline-block;
  }

  .hero-name-inner.revealed {
    transform: translateY(0);
  }

  /* Coral rule under BRADY */
  .name-rule {
    display: block;
    width: 56px;
    height: 3px;
    background: #f87060;
    border-radius: 2px;
    margin-top: 12px;
  }

  .hero-tagline {
    font-size: 1.125rem;
    color: #8c8680;
    max-width: 420px;
    line-height: 1.7;
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .hero-tagline.revealed {
    opacity: 1;
  }

  .hero-link {
    color: #f0ede8;
    text-decoration: none;
    opacity: 0;
    transition:
      opacity 400ms ease,
      color 200ms ease;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero-link.revealed {
    opacity: 1;
  }

  .hero-link:hover {
    color: #f87060;
  }

  .location-badge {
    color: #8c8680;
    border: 1px solid rgba(248, 112, 96, 0.3);
    padding: 4px 12px;
    border-radius: 9999px;
    letter-spacing: 0.08em;
  }

  .location-badge::first-letter {
    color: #f87060;
  }

  .hero-image-ring {
    background: linear-gradient(135deg, #f87060, #fbbdac, #f87060);
  }

  .hero-photo {
    filter: grayscale(20%);
    transition: filter 400ms ease;
  }

  .hero-photo:hover {
    filter: grayscale(0%);
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(8px);
    }
  }

  .scroll-bounce {
    animation: bounce 2s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-name-inner {
      transform: translateY(0);
      transition: none;
    }
    .hero-tagline,
    .hero-link {
      opacity: 1;
      transition: none;
    }
    .scroll-bounce {
      animation: none;
    }
  }
</style>
