---

---

<section
  id="contact"
  class="h-screen flex items-center justify-center bg-myColor-900 relative overflow-hidden px-8"
>
  <div class="text-center space-y-6 relative z-10 max-w-3xl mx-auto">
    <p class="contact-label font-mono text-sm uppercase tracking-widest">
      Get in Touch
    </p>
    <h2 class="contact-headline">
      Let's work<br/>together.
    </h2>
    <a
      href="https://linkedin.com/in/adampbrady"
      target="_blank"
      rel="noopener noreferrer"
      class="contact-link font-mono text-sm inline-block mt-4"
    >
      Connect on LinkedIn →
    </a>
    <footer class="contact-footer font-mono text-xs mt-16">
      <span>adam [at] adampbrady.com</span>
      <span class="mx-3 opacity-30">·</span>
      <span>© 2026 Adam Brady</span>
    </footer>
  </div>
</section>

<style>
  .contact-label {
    color: #8c8680;
    letter-spacing: 0.15em;
  }

  .contact-headline {
    font-family: var(--font-family-display);
    font-size: clamp(48px, 8vw, 96px);
    color: #f0ede8;
    line-height: 1.05;
  }

  .contact-link {
    color: #f0ede8;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: #f87060;
    letter-spacing: 0.05em;
    transition: color 200ms ease;
  }

  .contact-link:hover {
    color: #f87060;
  }

  .contact-footer {
    color: #5a5550;
    margin-top: 4rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-link {
      transition: none;
    }
  }
</style>
