---

---

<section
  class="h-screen flex items-center justify-center bg-linear-to-b from-myColor-600 to-myColor-500 relative overflow-hidden"
>
  <!-- Accent glow blob -->
  <div class="absolute inset-0 pointer-events-none flex items-center justify-center">
    <div style="width: 500px; height: 500px; background: radial-gradient(circle, rgba(16, 185, 129, 0.12) 0%, transparent 70%); border-radius: 50%;"></div>
  </div>

  <div class="text-center space-y-8 px-6 relative z-10">
    <h2
      class="text-6xl md:text-7xl lg:text-8xl font-bold font-mono text-white mb-8"
    >
      Get in Touch
    </h2>
    <p class="text-xl md:text-2xl text-white max-w-2xl mx-auto mb-8">
      I'd love to hear from you! Feel free to reach out on LinkedIn to connect.
    </p>
    <a
      href="https://linkedin.com/in/adampbrady"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block px-8 py-4 font-semibold rounded-lg font-sans shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200 text-white text-lg contact-btn"
    >
      Connect on LinkedIn
    </a>
  </div>
</section>

<style>
  .contact-btn {
    background: linear-gradient(135deg, #10b981, #059669);
  }
  .contact-btn:hover {
    background: linear-gradient(135deg, #34d399, #10b981);
    box-shadow: 0 8px 24px rgba(16, 185, 129, 0.35);
  }
</style>
