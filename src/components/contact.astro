---

---

<section
  id="contact"
  class="h-screen flex items-center justify-center bg-myColor-900 relative overflow-hidden px-8"
>
  <div class="contact-dot-grid absolute inset-0 pointer-events-none"></div>
  <div class="text-center space-y-6 relative z-10 max-w-3xl mx-auto">
    <p class="contact-label font-mono text-sm uppercase tracking-widest">
      Get in Touch
    </p>
    <h2 class="contact-headline">
      Let's work<br />together.
    </h2>
    <a
      href="https://linkedin.com/in/adampbrady"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Connect on LinkedIn (opens in a new tab)"
      class="contact-link font-mono text-sm inline-block mt-4"
    >
      Connect on LinkedIn <span aria-hidden="true">→</span>
    </a>
    <p class="contact-footer font-mono text-xs">
      <span>adampaulbrady [at] gmail.com</span>
      <span class="mx-3 opacity-30">·</span>
      <span>© 2026 Adam Brady</span>
    </p>
  </div>
</section>

<style>
  .contact-dot-grid {
    background-image: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.14) 1px,
      transparent 1px
    );
    background-size: 24px 24px;
  }

  .contact-label {
    color: var(--color-myColor-400);
    letter-spacing: 0.15em;
  }

  .contact-headline {
    font-family: var(--font-family-display);
    font-size: clamp(48px, 8vw, 96px);
    color: var(--color-text-primary);
    line-height: 1.05;
  }

  .contact-link {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-accent);
    letter-spacing: 0.05em;
    transition: color 200ms ease;
  }

  .contact-link:hover {
    color: var(--color-accent);
  }

  .contact-footer {
    color: var(--color-myColor-500);
    margin-top: 4rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-link {
      transition: none;
    }
  }
</style>
