---
interface Props {
  title: string;
  company: string;
  year: string;
  summary: string;
}

const { title, company, year, summary } = Astro.props;
---

<li class="timeline-item">
  <div class="timeline-content">
    <p class="timeline-year">{year}</p>
    <h3 class="timeline-company">{company}</h3>
    <p class="timeline-title">{title}</p>
    <p class="timeline-summary">{summary}</p>
  </div>
</li>

<style>
  .timeline-item {
    position: relative;
    padding-left: 40px;
    padding-bottom: 50px;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  /* Coral dot on the timeline */
  .timeline-item::before {
    content: "";
    position: absolute;
    left: -6px;
    top: 8px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #f87060;
    border: 2px solid #fbbdac;
    box-shadow: 0 0 10px 3px rgba(248, 112, 96, 0.4), 0 0 0 4px rgba(248, 112, 96, 0.1);
    z-index: 1;
  }

  .timeline-content {
    background: rgba(255, 255, 255, 0.06);
    padding: 24px;
    border-radius: 8px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: transform 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
  }

  .timeline-content:hover {
    background: rgba(255, 255, 255, 0.09);
    transform: translateX(5px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(248, 112, 96, 0.15);
  }

  /* Year: top label, coral, mono — comes first in DOM order */
  .timeline-year {
    font-size: 0.75rem;
    color: #f87060;
    font-family: var(--font-family-title);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 6px 0;
  }

  /* Company: prominent — large and white */
  .timeline-company {
    font-size: 1.25rem;
    font-weight: 700;
    color: #f0ede8;
    margin: 0 0 4px 0;
  }

  /* Title: subordinate — muted italic */
  .timeline-title {
    font-size: 1rem;
    font-weight: 500;
    color: #8c8680;
    margin: 0 0 16px 0;
    font-style: italic;
  }

  .timeline-summary {
    font-size: 0.9375rem;
    color: rgba(240, 237, 232, 0.75);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 768px) {
    .timeline-item {
      padding-left: 30px;
    }

    .timeline-company {
      font-size: 1.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-content {
      transition: none;
    }
  }
</style>
