---
interface Props {
  title: string;
  company: string;
  year: string;
  summary: string;
}

const { title, company, year, summary } = Astro.props;
---

<li class="timeline-item">
  <div class="timeline-content">
    <h3 class="timeline-title">{title}</h3>
    <p class="timeline-company">{company}</p>
    <p class="timeline-year">{year}</p>
    <p class="timeline-summary">{summary}</p>
  </div>
</li>

<style>
  .timeline-item {
    position: relative;
    padding-left: 40px;
    padding-bottom: 50px;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  /* Circle dot on the timeline */
  .timeline-item::before {
    content: "";
    position: absolute;
    left: -6px;
    top: 8px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #10b981;
    border: 2px solid #34d399;
    box-shadow: 0 0 10px 3px rgba(16, 185, 129, 0.4), 0 0 0 4px rgba(16, 185, 129, 0.1);
    z-index: 1;
  }

  .timeline-content {
    background: rgba(255, 255, 255, 0.1);
    padding: 24px;
    border-radius: 8px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.3s ease;
  }

  .timeline-content:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateX(5px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
  }

  .timeline-title {
    font-size: 1.5rem;
    font-weight: bold;
    color: white;
    margin: 0 0 8px 0;
  }

  .timeline-company {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 0 4px 0;
    font-style: italic;
  }

  .timeline-year {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 16px 0;
    font-weight: 600;
  }

  .timeline-summary {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .timeline-item {
      padding-left: 30px;
    }

    .timeline-title {
      font-size: 1.25rem;
    }

    .timeline-company {
      font-size: 1rem;
    }
  }
</style>
